# Copy to .env (git-ignored) and fill in. Never commit real keys.
# CSCS-hosted Apertus (Hack Apertus free inference API) or any OpenAI-compatible endpoint (vLLM, Ollama, llama.cpp).
# LLM_NAME: a model id listed by GET $LLM_BASE_URL/models (CSCS endpoint, 2026-10-04: Apertus-v1.5-70B chosen)
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=https://REPLACE-WITH-CSCS-ENDPOINT/v1
LLM_API_KEY=
# Optional
# LLM_MODE=real        # real | stub | off | record   (default: real if LLM_BASE_URL+LLM_NAME set, else stub)
# LLM_JSON_MODE=0      # 1 = send response_format={"type":"json_object"} if the server supports it
# LLM_TIMEOUT_S=30
# LLM_RETRIES=3        # retries on HTTP 429/5xx with exponential backoff (2 s, 4 s, 8 s; honours Retry-After)
