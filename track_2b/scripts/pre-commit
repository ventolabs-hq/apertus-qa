#!/bin/sh
# Git pre-commit hook (install with `make install-hooks` from track_2b/): blocks a commit if the model endpoint key or
# base URL appears in the staged diff, the work tree or anywhere in the git database. Secret values are read at runtime
# from LLM_API_KEY / LLM_BASE_URL or $LEAK_CHECK_ENV_FILE / $LEAK_CHECK_KEY_FILE and are never printed.
set -e
cd "$(git rev-parse --show-toplevel)/track_2b"
exec python3 scripts/leak_check.py --staged --tree --history
